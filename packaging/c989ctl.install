post_install() {
    cat <<'EOF'
==> c989ctl installed (built and tested for C989 Firmware 1.82.0.0 on Arch Linux / i3 / X11).
==> Unplug and replug your Cloud Nine C989 keyboard (or run `sudo udevadm trigger`)
    so the udev rule (/usr/lib/udev/rules.d/70-c989.rules) grants non-root hidraw access.
==> Launch the GUI via `c989ctl-gui` (available in dmenu / application launchers)
    or use the CLI via `c989ctl --help`.
==> Optional host macro/launcher daemon is disabled by default. To enable it at login:
    systemctl --user enable --now c989ctl-daemon.service
EOF
}

post_upgrade() {
    post_install
}
